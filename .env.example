# Copy to .env and fill in. .env is git-ignored. Never commit real values.

# --- Kaggle (only needed by scripts/download_data.py) ---------------------
# Preferred: place your token in ~/.kaggle/kaggle.json (Kaggle > Settings > API).
# Alternative: set these two variables.
# KAGGLE_USERNAME=
# KAGGLE_KEY=

# --- Snowflake (targets: dev, prod) ---------------------------------------
# Account identifier in <orgname>-<account_name> form.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=CREDIT_RISK_ENGINEER
SNOWFLAKE_WAREHOUSE=CREDIT_RISK_WH
SNOWFLAKE_DATABASE_DEV=CREDIT_RISK_DEV
SNOWFLAKE_DATABASE_PROD=CREDIT_RISK_PROD

# Key-pair authentication (recommended; used by dbt and the loader).
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# Password authentication (loader only; accounts enforcing MFA will reject it).
SNOWFLAKE_PASSWORD=

# --- DuckDB (target: ci) ---------------------------------------------------
# Defaults to data/ci/credit_risk.duckdb; override only if needed.
# DUCKDB_PATH=

# --- Airflow (orchestration/airflow/docker-compose.yml) ---------------------
# Generate your own values; the ones below are EXAMPLES and must not be reused.
#   JWT secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
#   Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__API_AUTH__JWT_SECRET=example-jwt-secret-replace-with-your-own-random-value
AIRFLOW__CORE__FERNET_KEY=example-fernet-key-replace-with-a-generated-url-safe-base64-32-byte-key=
# Concurrent warehouse-writing tasks. 1 for the DuckDB ci target (single writer); 4 for Snowflake
# dev (matches the dbt threads in profiles.yml). One pool serves both targets: set it before `up`.
DBT_POOL_SLOTS=1
